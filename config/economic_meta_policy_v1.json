{
  "version": "economic-meta-policy-v1",
  "mode": "SHADOW_ONLY",
  "calibration_status": "PREREGISTERED_SHADOW_UNVALIDATED",
  "primary_horizon_days": 20,
  "secondary_horizons_days": [5, 10, 40],
  "policies": {
    "META-A": {
      "objective": "common confidence gate",
      "buy_min_abs_score": 0.10,
      "sell_min_abs_score": 0.10,
      "require_edge_evidence": false
    },
    "META-B": {
      "objective": "asymmetric BUY/SELL confidence gate",
      "buy_min_abs_score": 0.15,
      "sell_min_abs_score": 0.10,
      "require_edge_evidence": false
    },
    "META-C": {
      "objective": "defensive extreme challenger",
      "buy_min_abs_score": 0.20,
      "sell_min_abs_score": 0.12,
      "require_edge_evidence": true,
      "min_edge_buffer_bps": 25.0
    }
  },
  "common_gates": {
    "max_estimated_cost_bps": 250.0,
    "max_portfolio_turnover": 0.35
  },
  "evaluation": {
    "comparators": ["CURRENT", "HOLD"],
    "metrics": [
      "net_pnl_or_return",
      "dva_vs_hold",
      "delta_vs_current",
      "max_drawdown_proxy",
      "turnover",
      "cost_drag",
      "tail_loss_p10",
      "profit_factor",
      "n_effective",
      "top1_positive_share",
      "top3_positive_share"
    ]
  },
  "promotion": {
    "auto_promotion": false,
    "requires_positive_dva_20d_vs_hold": true,
    "requires_positive_delta_20d_vs_current": true,
    "requires_sufficient_effective_sample": true,
    "requires_manual_risk_review": true,
    "requires_no_material_drawdown_deterioration": true,
    "requires_no_material_tail_loss_deterioration": true,
    "requires_no_material_cost_drag_deterioration": true
  },
  "hard_guards": {
    "affects_production_recommendation": false,
    "affects_sizing": false,
    "affects_execution": false,
    "capital_effect": false
  },
  "notes": [
    "Thresholds are heuristic preregistration values, not fitted historical optima.",
    "Historical Analytics v2 motivates testing direction asymmetry but does not validate these thresholds.",
    "Promotion requires prospective point-in-time evidence; this configuration must remain shadow-only until then."
  ]
}
