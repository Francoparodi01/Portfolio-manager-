      "expected_intents": ["bot_follow_pnl", "bot_follow_pnl"],
      "must_offer_tools": ["get_decision_ledger"],
      "forbidden_tools": ["get_bot_follow_pnl", "get_net_decision_report"]
    },
    {
      "id": "normalized-provenance-chain",
      "turns": [
        "cuanto pnl hubiese ganado siguiendo las decisiones del bot los ultimos 25 días",
