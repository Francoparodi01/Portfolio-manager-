        "que datos usaste?"
      ],
      "expected_intents": ["bot_follow_pnl", "bot_follow_pnl", "evidence_provenance"],
      "must_offer_tools": ["get_run_evidence_provenance"],
      "forbidden_tools": ["get_bot_follow_pnl", "get_system_status", "get_macro_context", "get_portfolio_snapshot"]
