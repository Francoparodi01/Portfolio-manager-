      "forbidden_tools": ["execute_order"]
    },
    {
      "id": "position-comparison-followup",
      "turns": ["¿Qué hago con GDX?", "comparalo con NVDA"],
      "expected_intents": ["position_analysis", "position_comparison"],
      "expected_active_symbols": ["GDX", "NVDA"]
    },
    {
      "id": "opportunity-replacement",
      "turns": ["Buscame oportunidades para reemplazar lo peor que tengo."],
