# Quantia bounded agentic + conversational harness
# Enable after running the validation documented in docs/architecture/conversational-harness.md.
QUANTIA_AGENT_ENABLED=false

# Local model endpoint. No model receives a trade-execution capability.
QUANTIA_AGENT_MODEL=qwen2.5:3b
QUANTIA_AGENT_OLLAMA_URL=http://host.docker.internal:11434
QUANTIA_AGENT_MODEL_TIMEOUT_SECONDS=60

# Central model roles. They may point to the same model.
QUANTIA_LLM_ROUTER=qwen2.5:3b
QUANTIA_LLM_REASONING=qwen2.5:3b
QUANTIA_LLM_SYNTHESIS=qwen2.5:3b
QUANTIA_LLM_VERIFIER=qwen2.5:3b

# Existing agent controls.
QUANTIA_AGENT_MAX_STEPS=8
QUANTIA_AGENT_TOOL_TIMEOUT_SECONDS=600
QUANTIA_AGENT_TOOL_OUTPUT_CHARS=18000
QUANTIA_AGENT_MODEL_HISTORY_CHARS=16000
QUANTIA_AGENT_MODEL_OBSERVATION_CHARS=6000
QUANTIA_AGENT_REQUIRE_AUDIT=true

# Conversational harness budgets.
QUANTIA_HARNESS_MAX_STEPS=8
QUANTIA_HARNESS_MAX_TOOL_CALLS=10
QUANTIA_HARNESS_MAX_RETRIES=1
QUANTIA_HARNESS_MAX_SECONDS=300
QUANTIA_HARNESS_CONTEXT_CHARS=16000
QUANTIA_HARNESS_OBSERVATION_CHARS=6000

# Context compaction / synthesis.
QUANTIA_HARNESS_SYNTHESIS_ENABLED=true
QUANTIA_HARNESS_SYNTHESIS_TIMEOUT_SECONDS=45
QUANTIA_HARNESS_SYNTHESIS_EVIDENCE_CHARS=24000

# State and memory. Conversation state is short lived; memory is restricted to
# methodology/configuration/structural preferences, never a raw transcript.
QUANTIA_HARNESS_SESSION_TTL_SECONDS=86400
QUANTIA_HARNESS_MEMORY_TTL_SECONDS=2592000
