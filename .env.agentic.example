# Quantia bounded agentic / conversational harness
# The legacy CLI loop still honors QUANTIA_AGENT_ENABLED. The production Telegram
# gateway uses the bounded conversational harness directly.
QUANTIA_AGENT_ENABLED=false

# Existing local controller defaults.
QUANTIA_AGENT_MODEL=qwen2.5:3b
QUANTIA_AGENT_OLLAMA_URL=http://host.docker.internal:11434
QUANTIA_AGENT_MODEL_TIMEOUT_SECONDS=60

# Central model roles. They may point to the same model; separate models are only
# useful when latency/cost/quality measurements justify it.
QUANTIA_LLM_ROUTER=qwen2.5:3b
QUANTIA_LLM_REASONING=qwen2.5:3b
QUANTIA_LLM_SYNTHESIS=qwen2.5:3b
QUANTIA_LLM_VERIFIER=qwen2.5:3b
QUANTIA_HARNESS_LLM_FALLBACK=true

# Legacy loop controls.
QUANTIA_AGENT_MAX_STEPS=8
QUANTIA_AGENT_TOOL_TIMEOUT_SECONDS=600
QUANTIA_AGENT_TOOL_OUTPUT_CHARS=18000
QUANTIA_AGENT_MODEL_HISTORY_CHARS=16000
QUANTIA_AGENT_MODEL_OBSERVATION_CHARS=6000

# Conversational harness budgets. The runtime stops instead of looping forever.
QUANTIA_HARNESS_MAX_STEPS=8
QUANTIA_HARNESS_MAX_TOOL_CALLS=10
QUANTIA_HARNESS_MAX_IDENTICAL_CALLS=1
QUANTIA_HARNESS_MAX_RETRIES=1
QUANTIA_HARNESS_MAX_SECONDS=300
QUANTIA_HARNESS_CONTEXT_CHARS=18000
QUANTIA_HARNESS_EVIDENCE_CHARS=12000

# Structured conversational references are hot state, not financial truth.
# They expire and can be safely reconstructed from the audit boundary.
QUANTIA_CONVERSATION_TTL_SECONDS=86400

# Production default: fail closed if the audit trace cannot be persisted.
QUANTIA_AGENT_REQUIRE_AUDIT=true
