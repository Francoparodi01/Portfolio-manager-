# Quantia bounded agentic + conversational harness
# Enable after running the validation documented in docs/architecture/conversational-harness.md.
QUANTIA_AGENT_ENABLED=false

# Local model endpoint. No model receives a trade-execution capability.
QUANTIA_AGENT_MODEL=qwen3.5:9b
QUANTIA_AGENT_OLLAMA_URL=http://host.docker.internal:11434
QUANTIA_AGENT_MODEL_TIMEOUT_SECONDS=60
QUANTIA_OLLAMA_KEEP_ALIVE=30m

# Central model roles. They may point to the same already-loaded Ollama model.
QUANTIA_LLM_ROUTER=qwen3.5:9b
QUANTIA_LLM_REASONING=qwen3.5:9b
QUANTIA_LLM_SYNTHESIS=qwen3.5:9b
QUANTIA_LLM_VERIFIER=qwen3.5:9b

# Semantic routing: the LLM labels intent/entities/window only. It never selects
# arbitrary tools or computes financial facts. TaskParser remains fail-safe fallback.
QUANTIA_SEMANTIC_ROUTER_ENABLED=true
QUANTIA_ROUTER_TIMEOUT_SECONDS=15
QUANTIA_ROUTER_CONTEXT_TOKENS=2048
QUANTIA_ROUTER_NUM_PREDICT=160

# Existing agent controls.
QUANTIA_AGENT_MAX_STEPS=8
QUANTIA_AGENT_TOOL_TIMEOUT_SECONDS=600
QUANTIA_AGENT_TOOL_OUTPUT_CHARS=18000
QUANTIA_AGENT_MODEL_HISTORY_CHARS=16000
QUANTIA_AGENT_MODEL_OBSERVATION_CHARS=6000
QUANTIA_AGENT_REQUIRE_AUDIT=true

# Conversational harness budgets.
QUANTIA_HARNESS_MAX_STEPS=8
QUANTIA_HARNESS_MAX_TOOL_CALLS=10
QUANTIA_HARNESS_MAX_RETRIES=1
QUANTIA_HARNESS_MAX_SECONDS=300
QUANTIA_HARNESS_CONTEXT_CHARS=16000
QUANTIA_HARNESS_OBSERVATION_CHARS=6000

# Grounded natural-language synthesis. Evidence is compacted before reaching the
# model; deterministic renderers remain the fallback if synthesis/verifier fails.
QUANTIA_HARNESS_SYNTHESIS_ENABLED=true
QUANTIA_HARNESS_SYNTHESIS_TIMEOUT_SECONDS=45
QUANTIA_HARNESS_SYNTHESIS_EVIDENCE_CHARS=3500
QUANTIA_SYNTHESIS_CONTEXT_TOKENS=4096
QUANTIA_SYNTHESIS_NUM_PREDICT=220
# Provenance stays deterministic so exact audited sources cannot be paraphrased away.
QUANTIA_HARNESS_SYNTHESIS_BYPASS_INTENTS=evidence_provenance

# Stale-while-revalidate portfolio behavior. Existing timestamped snapshots are
# used immediately; a stale snapshot is refreshed in background. Missing data or
# an explicit live/refresh request still blocks on the operational refresh.
QUANTIA_CHAT_SNAPSHOT_FRESH_SECONDS=120

# State and memory. Conversation state is short lived; last_task stores validated
# semantics (intent/entities/window/aggregation), not an assistant transcript.
QUANTIA_HARNESS_SESSION_TTL_SECONDS=86400
QUANTIA_HARNESS_MEMORY_TTL_SECONDS=2592000
