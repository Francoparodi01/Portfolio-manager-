# Quantia bounded agent loop
QUANTIA_AGENT_ENABLED=false
QUANTIA_AGENT_MODEL=qwen2.5:3b
QUANTIA_AGENT_OLLAMA_URL=http://host.docker.internal:11434
QUANTIA_AGENT_MODEL_TIMEOUT_SECONDS=60
QUANTIA_AGENT_MAX_STEPS=8
QUANTIA_AGENT_TOOL_TIMEOUT_SECONDS=600
QUANTIA_AGENT_TOOL_OUTPUT_CHARS=18000
QUANTIA_AGENT_MODEL_HISTORY_CHARS=48000
QUANTIA_AGENT_MODEL_OBSERVATION_CHARS=9000
QUANTIA_AGENT_REQUIRE_AUDIT=true

# Jev / TypeSafe System One router
# Rollout: off -> shadow -> active. Never commit the API key.
QUANTIA_AGENT_ROUTER=off
QUANTIA_JEV_API_KEY=
QUANTIA_JEV_BASE_URL=https://api.typesafe.ai
QUANTIA_JEV_MODEL=jev-latest
QUANTIA_JEV_TIMEOUT_SECONDS=5
QUANTIA_JEV_CONFIDENCE_THRESHOLD=0.85
QUANTIA_JEV_MAX_RETRIES=1
QUANTIA_JEV_RETRY_BACKOFF_MS=250
QUANTIA_JEV_STATE_OBSERVATION_CHARS=3000
