# Quantia bounded agentic loop
# Disabled by default. Enable only after running the smoke checks in docs/15-agentic-loop.md.
QUANTIA_AGENT_ENABLED=false

# Local controller model. The model selects read-only tools; it cannot execute trades.
QUANTIA_AGENT_MODEL=qwen2.5:3b
QUANTIA_AGENT_OLLAMA_URL=http://host.docker.internal:11434
QUANTIA_AGENT_MODEL_TIMEOUT_SECONDS=60

# Hard control limits.
QUANTIA_AGENT_MAX_STEPS=8
QUANTIA_AGENT_TOOL_TIMEOUT_SECONDS=600
QUANTIA_AGENT_TOOL_OUTPUT_CHARS=18000
# The controller explicitly requests a 16384-token context; these are hard-capped.
QUANTIA_AGENT_MODEL_HISTORY_CHARS=16000
QUANTIA_AGENT_MODEL_OBSERVATION_CHARS=6000

# Production default: the loop fails closed if its audit trace cannot be persisted.
QUANTIA_AGENT_REQUIRE_AUDIT=true
